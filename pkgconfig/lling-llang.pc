prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: lling-llang
Description: High-performance weighted finite-state transducer algebra
Version: 4.0.0-rc.3
Requires: vinary-tree-interop = 4.0.0-rc.3
Libs: -L${libdir} -llling_llang
Libs.private: -ldl -lpthread -lm
Cflags: -I${includedir}
