  "packageVersion": "4.0.0-rc.6",
  "abiVersion": 1,
  "apiRevision": 5,
  "cPrefix": "lling_",
  "headers": {
    "c": "include/lling_llang.h",
    "cpp": "include/lling_llang.hpp"
  },
  "snapshot": {
    "boundary": "capture-before-traversal",
    "revision": "immutable-resource",
    "captureComplexity": "O(1)",
    "importCopyComplexity": "O(reachable-states-and-arcs)",
    "compositionExpansion": "lazy-cached-product-states"
  },
  "marshalling": {
    "wfstHandoff": "O(1)-retained-two-word-resource",
    "wfstComposition": "retained-snapshots-and-lazy-product-states",
    "wfstExpansion": "one-batched-state-and-paged-contiguous-arcs",
    "customProviderDefault": "serialized-caller-thread",
    "customProviderOptIn": "parallel-reentrant",
    "dynamicSemiringHandoff": "retained-context-and-two-word-provider-tokens",
    "dynamicSemiringBatch": "bounded-256-value-folds",
    "dynamicLatticeHandoff": "one-retained-resource-per-immutable-value",
    "dynamicLatticeBatch": "bounded-256-value-folds-with-pairwise-fallback"
  },
  "enums": {
    "status": {
      "cType": "LlingStatus",
      "cPrefix": "LLING_STATUS_",
      "rustType": "LlingStatus",
      "values": {
        "OK": 0,
        "INVALID_ARGUMENT": 1,
        "NULL_POINTER": 2,
        "PANIC": 3,
        "INCOMPATIBLE_RESOURCE": 4,
        "PROVIDER_ERROR": 5,
        "LIMIT_EXCEEDED": 6,
        "CLOSED": 7
      }
    }
  },
  "objects": {
    "LlingWfstBuilder": {
      "ownership": "caller-owned-until-build",
      "methods": [
        "new",
        "free",
        "reserve_states",
        "add_state",
        "set_start",
        "set_final",
        "clear_final",
        "add_arc",
        "build"
      ]
    },
    "LlingWfst": {
      "ownership": "caller-owned-immutable",
      "methods": [
        "free",
        "import",
        "compose",
        "resource"
      ]
    },
    "ScalarWfstResource": {
      "interface": "vt.scalar-wfst.1",
      "unitDomain": "UNICODE_SCALAR",
      "producedWeightDomains": [
        "tropical-f64",
        "log-f64",
        "probability-f64",
        "arctic-f64",
        "signed-tropical-f64",
        "count-f64",
        "boolean-f64"
      ],
      "consumedWeightDomain": "tropical-f64",
      "methods": [
        "snapshot",
        "start",
        "num_states",
        "state_info",
        "state_arcs"
      ]
    },
    "HostScalarWfstProvider": {
      "languages": [
        "Julia",
        "Raku"
      ],
      "snapshot": "identity-with-retain immutable revision",
      "callbacks": [
        "start",
        "num_states",
        "state_info",
        "state_arcs"
      ],
      "callbackLocking": "customer callbacks execute without facade or native resource locks",
      "defaultThreading": "serialized by the native consumer",
      "optInThreading": "parallel and reentrant",
      "stateCaching": "one immutable complete state per state identifier"
    },
    "DynamicSemiringContext": {
      "interface": "vt.semiring.*1",
      "ownership": "retained-operation-context-and-explicit-owned-value-handles",
      "threading": "same-thread-by-default; Rust-only promotion after PARALLEL_REENTRANT validation",
      "capabilities": [
        "base-algebra",
        "division",
        "kleene-star",
        "numerical-projections",
        "declared-laws"
      ],
      "validation": "wire-output checks plus bounded representative law probes"
    },
    "DynamicLatticeValue": {
      "interface": "vt.lattice.val.1",
      "ownership": "one-independent-retained-resource-per-immutable-value",
      "threading": "same-thread C and managed-runtime handles; Rust promotion only after PARALLEL_REENTRANT validation",
      "capabilities": [
        "join",
        "meet",
        "semantic-equality",
        "stable-encoding",
        "diagnostics",
        "bounded-batch-folds"
      ],
      "validation": "base and capability ABI checks, exact output ownership, domain preservation, bounded buffers, and representative lattice-law probes"
    },
    "LlingCancellationV2": {
      "ownership": "caller-owned-single-release-pointer-slot",
      "threadSafety": "atomic-first-reason-wins",
      "methods": [
        "new",
        "request",
        "reason",
        "free"
      ]
    }
  },
  "typedAbiV2": {
    "metadataVersion": 2,
    "migration": "additive-to-opaque-v1",
    "layouts": {
      "header": 24,
      "id128": 16,
      "digest256": 32,
      "wfstDescriptor": 120,
      "budget": 72,
      "outcome": 96
    },
    "signatureAxes": [
      "inputTape",
      "outputTape",
      "algebra"
    ],
    "identityAxes": [
      "snapshot",
      "context"
    ],
    "outcomeAxes": [
      "precision",
      "completeness",
      "applicability",
      "termination",
      "evidence"
    ],
    "wireRules": [
      "raw-discriminants-validated-before-enum-decoding",
      "unknown-flags-and-nonzero-reserved-fields-rejected",
      "inactive-optional-fields-and-limits-are-zero",
      "larger-struct-size-is-an-additive-tail",
      "cancelled-or-budget-exhausted-results-do-not-publish-handles"
    ]
  },
  "forbiddenFacadeSymbols": [
    "ldict_",
    "dual_"
  ],
