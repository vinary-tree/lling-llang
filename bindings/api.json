  "name": "lling-llang",
  "author": {
    "name": "Dylon Edwards",
    "email": "dylon.devo@gmail.com"
  },
  "organization": {
    "github": "vinary-tree",
    "npmScope": "vinary-tree"
  },
  "interop": {
    "crate": "vinary-tree-interop",
    "cPrefix": "vt_",
    "cHeader": "vinary_tree_interop.h",
    "npm": "@vinary-tree/vinary-tree-interop",
    "resourceLayout": [
      "context",
      "vtable"
    ],
    "scalarWfstInterfaceId": "vt.scalar-wfst.1",
    "scalarWfstInterfaceVersion": 1,
    "semiringInterfaceId": "vt.semiring.val1",
    "semiringInterfaceVersion": 1,
    "latticeInterfaceId": "vt.lattice.val.1",
    "latticeInterfaceVersion": 1
  },
  "packages": {
    "cratesIo": "lling-llang",
    "npm": "@vinary-tree/lling-llang",
    "julia": "LlingLlang",
    "zef": "Lling-Llang"
  },
