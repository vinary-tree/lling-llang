  "javascript": {
    "package": "@vinary-tree/lling-llang",
    "version": "4.0.0-rc.6",
    "dependencies": {
      "@vinary-tree/vinary-tree-interop": "4.0.0-rc.6",
      "@vinary-tree/javascript-runtime": "4.0.0-rc.6"
    },
    "exports": [
      ".",
      "./typescript",
      "./clojurescript",
      "./wasm",
      "./wasi",
      "./cljs/vinary_tree/lling_llang.cljs"
    ],
    "facadeExports": [
      "runtimeIdentity",
      "vectorWfst",
      "compose"
    ],
    "cljsNamespace": "vinary-tree.lling-llang",
    "cljsExports": [
      "vector-wfst",
      "add-state!",
      "set-start!",
      "set-final!",
      "add-arc!",
      "build!",
      "compose",
      "start",
      "state",
      "close!"
