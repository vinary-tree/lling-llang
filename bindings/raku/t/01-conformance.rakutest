use v6.d;
use Test;
use NativeCall;
use Lling::Llang;

module LatticeFixture {
    use LLattice;

    our sub make(Int:D $value) {
        provider(
            MaxMin.new(:$value),
            domain-id => 'test.maxmin.v1..',
            encode => -> $item { $item.value.Str.encode('utf8') },
        )
    }
}

plan 58;
my constant LATTICE-BATCH-FLAG = 1 +< 3;

is abi-version(), ABI-VERSION, 'native and Raku ABI versions agree';
ok api-revision() >= API-REVISION, 'native API revision satisfies the facade';
is nativesizeof(AbiV2Header), 24, 'typed ABI-v2 header layout is stable';
is nativesizeof(BudgetV2), 72, 'typed ABI-v2 budget layout is stable';
is nativesizeof(OutcomeV2), 96, 'typed ABI-v2 outcome layout is stable';
my $abi-v2-header = AbiV2Header.new(struct-size => nativesizeof(BudgetV2));
lives-ok { validate-abi-v2-header($abi-v2-header, nativesizeof(BudgetV2)) },
    'Raku validates a canonical typed ABI-v2 header';
my $budget-v2 = BudgetV2.new(max-states => 100, max-work => 1_000);
is $budget-v2.header.flags, BUDGET-STATES +| BUDGET-WORK,
    'budget constructor derives canonical presence flags';
lives-ok { validate-budget-v2($budget-v2) },
    'Raku validates a canonical typed ABI-v2 budget';
my $outcome-v2 = OutcomeV2.new(
    precision => 1, completeness => 1, applicability => 1,
    termination => 1, evidence => 2,
    states => 2, arcs => 1, bytes => 64, work => 3,
    limitations => 0,
);
ok authoritative-exact($outcome-v2,
        resource-present => True, evidence-present => True),
    'Raku recognizes an exact complete verified result as authoritative';
my $cancellation-v2 = CancellationV2.new;
nok $cancellation-v2.reason.defined,
    'new cancellation resources have no requested reason';
$cancellation-v2.request(REQUESTED);
is $cancellation-v2.reason, REQUESTED,
    'Raku publishes the first cancellation reason';
$cancellation-v2.request(DEADLINE);
is $cancellation-v2.reason, REQUESTED,
    'cancellation remains first-reason-wins';
$cancellation-v2.close;

my $builder = WfstBuilder.new(size-hint => 2);
my $first = $builder.add-state;
my $second = $builder.add-state;
is-deeply ($first, $second), (0, 1), 'builder allocates dense state identifiers';
$builder.set-start($first).set-final($second, 0.25);
$builder.add-arc($first, 'a', 'b', $second, 0.5);
my $graph = $builder.build;
nok $builder.opened, 'build consumes the builder';
is $graph.start, 0, 'built graph publishes its start state';
is $graph.state-count, 2, 'built graph publishes its exact state count';
is $graph.state-info(1).final-weight, 0.25, 'final weights cross NativeCall';
is $graph.arcs(0).head.output, 'b'.ord, 'Unicode labels cross NativeCall';
my $imported = import-wfst($graph);
is $imported.start, 0, 'import produces an independent owned graph';
$imported.close;

my @lattice-providers = (2, 7, 4).map: -> $value {
    LatticeFixture::make($value)
};
my @lattice-values = @lattice-providers.map({ dynamic-lattice-value($_.resource) });
.close for @lattice-providers;
my $lattice-join = @lattice-values[0].join(@lattice-values[1]);
my $lattice-meet = @lattice-values[0].meet(@lattice-values[1]);
my $lattice-join-many = @lattice-values[0].join-many(@lattice-values[1, 2]);
my $lattice-meet-many = @lattice-values[1].meet-many(@lattice-values[0, 2]);
is $lattice-join.stable-bytes.decode('utf8'), '7',
    'Raku lattice join crosses the validated lling-llang adapter';
is $lattice-meet.stable-bytes.decode('utf8'), '2',
    'Raku lattice meet crosses the validated lling-llang adapter';
is $lattice-join-many.stable-bytes.decode('utf8'), '7',
    'Raku lattice batch join crosses the validated adapter';
is $lattice-meet-many.stable-bytes.decode('utf8'), '2',
    'Raku lattice batch meet crosses the validated adapter';
ok $lattice-join.equivalent($lattice-join-many),
    'Raku lattice semantic equality crosses Rust';
is $lattice-join.domain-id.bytes.list.map(*.chr).join, 'test.maxmin.v1..',
    'Raku lattice domain identity survives negotiation';
ok $lattice-join.flags +& LATTICE-BATCH-FLAG,
    'Raku observes the validated bounded-batch capability';
validate-lattice-laws(@lattice-values);
.close for $lattice-join, $lattice-meet, $lattice-join-many,
    $lattice-meet-many, |@lattice-values;
nok @lattice-values[0].opened,
    'Raku dynamic lattice values close deterministically';

class ExampleProvider does WfstProvider {
    method start-state(--> UInt:D) { 0 }
    method state-count(--> Int:D) { 2 }
    method state(UInt:D $identifier --> ProviderState:D) {
        return ProviderState.new(arcs => [ProviderArc.new(
            input => 'b'.ord, output => 'c'.ord, target => 1, weight => 0.75,
        )]) if $identifier == 0;
        return ProviderState.new(final => True, final-weight => 0.125)
            if $identifier == 1;
        ProviderState.new(valid => False)
    }
}

my $host = provider(ExampleProvider.new, :acyclic);
is $host.start, 0, 'Raku provider publishes its start state';
is $host.state-count, 2, 'Raku provider publishes its state count';
my @host-arcs;
try {
    @host-arcs = $host.arcs(0);
    CATCH {
        default {
            diag provider-last-error;
            .rethrow;
        }
    }
}
is @host-arcs.head.output, 'c'.ord, 'Raku provider publishes arcs';
my $host-state = $host.state-info(1);
ok $host-state.final, 'Raku provider publishes finality';
is $host-state.final-weight, 0.125, 'Raku provider publishes final weight';

my $product = compose($graph, $host);
is $product.start, 0, 'lazy product has a stable dense start state';
my $arc = $product.arcs(0).head;
is $arc.input, 'a'.ord, 'composition preserves the left input tape';
is $arc.output, 'c'.ord, 'composition preserves the right output tape';
is $arc.weight, 1.25, 'composition multiplies tropical weights by addition';
is $product.state-info($arc.target).final-weight, 0.375,
    'composition combines both final weights';
my $snapshot = $product.snapshot;
$product.close;
is $snapshot.start, 0, 'snapshot remains valid after product close';
ok $host.opened, 'product close does not consume its input provider';
$snapshot.close;
$graph.close;
$host.close;
pass 'all owned resources close deterministically';

class TropicalSemiring does SemiringProvider {
    method zero(--> Mu) { Inf }
    method one(--> Mu) { 0e0 }
    method plus(Mu:D $left, Mu:D $right --> Mu) { min($left, $right) }
    method times(Mu:D $left, Mu:D $right --> Mu) { $left + $right }
    method equal(Mu:D $left, Mu:D $right --> Bool:D) { $left == $right }
    method approx-equal(Mu:D $left, Mu:D $right, Real:D $epsilon --> Bool:D) {
        self.equal($left, $right) || abs($left - $right) <= $epsilon
    }
    method natural-order(Mu:D $left, Mu:D $right --> Int:D) {
        $left < $right ?? -1 !! $left > $right ?? 1 !! 0
    }
    method stable-bytes(Mu:D $value --> Blob:D) { $value.Num.Str.encode('utf8') }
    method divide(Mu:D $dividend, Mu:D $divisor --> Mu) {
        $divisor == Inf ?? Mu !! $dividend - $divisor
    }
    method left-divide(Mu:D $value, Mu:D $divisor --> Mu) {
        self.divide($value, $divisor)
    }
    method star(Mu:D $value --> Mu) { $value >= 0 ?? 0e0 !! Mu }
    method numerical-value(Mu:D $value --> Mu) { $value.Num }
    method quantize(Mu:D $value, Real:D $epsilon --> Mu) {
        ($value / $epsilon).round.Int
    }
    method probability(Mu:D $value --> Mu) { exp(-$value) }
    method properties(--> UInt:D) { 1 +| 2 +| 4 +| 8 +| 16 +| 32 }
    method closure-bound(--> Mu) { 1 }
}

my $semiring-resource = semiring-provider(TropicalSemiring.new,
    domain-id => semiring-domain-id('test.tropical.v1'), :division, :star,
    :numeric, :stable-bytes);
my $semiring = semiring-context($semiring-resource);
$semiring-resource.close;
my $zero = $semiring.zero;
my $one = $semiring.one;
my $sum = $one.plus($zero);
my $semiring-product = $one.times($one);
my $semiring-sum-many = $semiring.plus-many([$zero, $one]);
my $semiring-product-many = $semiring.times-many([$one, $one]);
my $quotient = $semiring.divide($semiring-product, $one);
my $closure = $semiring.star($one);
is $semiring.properties, 63, 'Raku provider publishes declared semiring laws';
ok $semiring.equal($sum, $one), 'Raku semiring addition crosses Rust';
ok $semiring.equal($semiring-sum-many, $one),
    'Raku batched semiring addition crosses Rust';
ok $semiring.equal($semiring-product-many, $one),
    'Raku batched semiring multiplication crosses Rust';
is $semiring.diagnostic, 'TropicalSemiring',
    'Raku semiring domain diagnostics cross Rust';
is $semiring.diagnostic($one), '0e0',
    'Raku semiring weight diagnostics cross Rust';
ok $semiring.approx-equal($semiring-product, $one, 1e-12),
    'Raku approximate equality crosses Rust';
is $semiring.natural-order($one, $zero), -1,
    'Raku natural order crosses Rust';
is $semiring.numerical-value($semiring-product), 0e0,
    'Raku numerical projection crosses Rust';
is $semiring.quantize($semiring-product, 0.25), 0,
    'Raku quantization crosses Rust';
is $semiring.probability($semiring-product), 1e0,
    'Raku probability projection crosses Rust';
is $semiring.closure-bound, 1, 'Raku closure bound crosses Rust';
is $semiring.stable-bytes($one).decode('utf8'), '0',
    'Raku stable bytes cross Rust';
ok $quotient.defined, 'Raku optional division returns a weight';
ok $closure.defined, 'Raku optional closure returns a weight';
nok $semiring.divide($one, $zero).defined,
    'Raku undefined division remains explicitly partial';
$semiring.validate-laws([$zero, $one, $sum, $semiring-product],
    epsilon => 1e-12);
my $copy = $one.clone;
$one.close;
ok $semiring.equal($copy, $semiring-product),
    'cloned Raku weights own independent token references';
.close for $zero, $sum, $semiring-product, $semiring-sum-many,
    $semiring-product-many, $quotient, $closure, $copy;
$semiring.close;
nok $semiring.opened, 'Raku semiring resources close deterministically';
