; Decidable obligations for portable WPDS rule maps, replay, and decoding.
(set-logic ALL)

(echo "[LLING-WPDS-KEY-1]")
; A sealed external-key snapshot cannot contain a duplicate key.
(push)
(declare-const key-left Int)
(declare-const key-right Int)
(assert (= key-left key-right))
(assert (distinct key-left key-right))
(check-sat)
(pop)

(echo "[LLING-WPDS-KEY-2]")
; Distinct accepted external keys cannot share one dense identifier.
(push)
(declare-const key-a Int)
(declare-const key-b Int)
(declare-const dense-a Int)
(declare-const dense-b Int)
(assert (distinct key-a key-b))
(assert (= dense-a dense-b))
(assert (=> (= dense-a dense-b) (= key-a key-b)))
(check-sat)
(pop)

(echo "[LLING-WPDS-KEY-3]")
; Dense identity is stable for one key within one immutable snapshot.
(push)
(declare-fun dense-of (Int Int) Int)
(declare-const snapshot Int)
(declare-const key Int)
(assert (distinct (dense-of snapshot key) (dense-of snapshot key)))
(check-sat)
(pop)

(echo "[LLING-WPDS-ID-1]")
; Admission cannot succeed when any replay-identity field differs.
(push)
(declare-const rules-match Bool)
(declare-const context-match Bool)
(declare-const query-match Bool)
(declare-const semantics-match Bool)
(declare-const codec-match Bool)
(declare-const admitted Bool)
(define-fun exact-identity () Bool
  (and rules-match context-match query-match semantics-match codec-match))
(assert (= admitted exact-identity))
(assert admitted)
(assert (not exact-identity))
(check-sat)
(pop)

(echo "[LLING-WPDS-TERM-1]")
; Malformed, stale, over-budget, cancelled, or invalid witness data is never
; published as a successful replay result.
(push)
(declare-const malformed Bool)
(declare-const stale Bool)
(declare-const over-budget Bool)
(declare-const cancelled Bool)
(declare-const invalid-witness Bool)
(declare-const published Bool)
(define-fun rejected-input () Bool
  (or malformed stale over-budget cancelled invalid-witness))
(assert rejected-input)
(assert published)
(assert (=> rejected-input (not published)))
(check-sat)
(pop)

(echo "[LLING-WPDS-DEC-1]")
; A checked positive-width flat decoder step cannot pass the byte budget.
(push)
(declare-const cursor Int)
(declare-const width Int)
(declare-const byte-budget Int)
(declare-const next-cursor Int)
(assert (>= cursor 0))
(assert (> width 0))
(assert (<= (+ cursor width) byte-budget))
(assert (= next-cursor (+ cursor width)))
(assert (> next-cursor byte-budget))
(check-sat)
(pop)

(echo "[LLING-WPDS-PREM-1]")
; An accepted portable proof edge always points to an earlier node.
(push)
(declare-const node-index Int)
(declare-const premise-index Int)
(declare-const accepted Bool)
(assert accepted)
(assert (=> accepted (< premise-index node-index)))
(assert (>= premise-index node-index))
(check-sat)
(pop)

(echo "[LLING-WPDS-ID-2]")
; A mismatched replay identity has a constructive rejected model.
(push)
(declare-const rules-ok Bool)
(declare-const context-ok Bool)
(declare-const query-ok Bool)
(declare-const semantics-ok Bool)
(declare-const codec-ok Bool)
(declare-const resume-ok Bool)
(assert rules-ok)
(assert context-ok)
(assert (not query-ok))
(assert semantics-ok)
(assert codec-ok)
(assert (= resume-ok
  (and rules-ok context-ok query-ok semantics-ok codec-ok)))
(assert (not resume-ok))
(check-sat)
(pop)
