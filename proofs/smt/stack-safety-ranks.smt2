; Arithmetic counterexample queries for the stack-safety machines.
; Every query is expected to be UNSAT. SAT would be a counterexample to a
; resource/rank invariant and must fail the verification gate.

(set-logic QF_NIA)

(echo "binary-unary-step-strictly-decreases")
(push)
(declare-const child_nodes Int)
(declare-const continuation Int)
(assert (>= child_nodes 1))
(assert (>= continuation 0))
(assert (not (< (+ (* 3 child_nodes) 1 continuation)
                (+ (* 3 (+ 1 child_nodes)) continuation))))
(check-sat)
(pop)

(echo "binary-right-scheduling-strictly-decreases")
(push)
(declare-const rhs_nodes Int)
(declare-const continuation_2 Int)
(assert (>= rhs_nodes 1))
(assert (>= continuation_2 0))
(assert (not (< (+ (* 3 rhs_nodes) 1 continuation_2)
                (+ (* 3 rhs_nodes) 2 continuation_2))))
(check-sat)
(pop)

(echo "transducer-rule-selection-rank-decreases")
(push)
(declare-const max_pattern Int)
(declare-const input_size Int)
(declare-const pattern_size Int)
(assert (>= max_pattern 0))
(assert (>= input_size 0))
(assert (>= pattern_size 0))
(assert (<= pattern_size max_pattern))
(define-fun band () Int (+ max_pattern 2))
(assert
  (not
    (< (+ (* input_size band) pattern_size)
       (+ (* input_size band) max_pattern 1))))
(check-sat)
(pop)

(echo "transducer-subpattern-rank-decreases")
(push)
(declare-const max_pattern_2 Int)
(declare-const input_size_2 Int)
(declare-const parent_pattern Int)
(declare-const child_pattern Int)
(assert (>= max_pattern_2 0))
(assert (>= input_size_2 0))
(assert (>= child_pattern 0))
(assert (< child_pattern parent_pattern))
(assert (<= parent_pattern max_pattern_2))
(define-fun band_2 () Int (+ max_pattern_2 2))
(assert
  (not
    (< (+ (* input_size_2 band_2) child_pattern)
       (+ (* input_size_2 band_2) parent_pattern))))
(check-sat)
(pop)

(echo "transducer-variable-child-rank-decreases")
(push)
(declare-const max_pattern_3 Int)
(declare-const input_size_3 Int)
(declare-const child_input_size Int)
(declare-const pattern_size_3 Int)
(assert (>= max_pattern_3 0))
(assert (>= child_input_size 0))
(assert (< child_input_size input_size_3))
(assert (>= pattern_size_3 0))
(assert (<= pattern_size_3 max_pattern_3))
(define-fun band_3 () Int (+ max_pattern_3 2))
(assert
  (not
    (< (+ (* child_input_size band_3) max_pattern_3 1)
       (+ (* input_size_3 band_3) pattern_size_3))))
(check-sat)
(pop)

(echo "ordered-forest-success-bound")
(push)
(declare-const ordered_node_count Int)
(declare-const executed_steps Int)
(declare-const terminal_potential Int)
(assert (>= ordered_node_count 1))
(assert (>= executed_steps 0))
(assert (>= terminal_potential 0))
(assert
  (<= (+ executed_steps terminal_potential)
      (- (* 2 ordered_node_count) 1)))
(assert (> executed_steps (* 2 ordered_node_count)))
(check-sat)
(pop)
