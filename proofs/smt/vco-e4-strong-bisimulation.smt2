; Decidable boundary controls for certified strong bisimulation.
; Each push/pop block has one expected result in the adjacent .expected file.

(set-logic ALL)

; E4-BIS-SMT-MALFORMED-SOURCE-REJECTED
(push)
(declare-const state-count Int)
(declare-const source Int)
(assert (> state-count 0))
(assert (and (<= 0 source) (< source state-count)))
(assert (>= source state-count))
(check-sat)
(pop)

; E4-BIS-SMT-MALFORMED-TARGET-REJECTED
(push)
(declare-const state-count Int)
(declare-const target Int)
(assert (> state-count 0))
(assert (and (<= 0 target) (< target state-count)))
(assert (or (< target 0) (>= target state-count)))
(check-sat)
(pop)

; E4-BIS-SMT-MALFORMED-LABEL-REJECTED
(push)
(declare-const action-count Int)
(declare-const label Int)
(assert (> action-count 0))
(assert (and (<= 0 label) (< label action-count)))
(assert (>= label action-count))
(check-sat)
(pop)

; E4-BIS-SMT-VALID-EDGE-WITNESS
(push)
(declare-const state-count Int)
(declare-const action-count Int)
(declare-const source Int)
(declare-const label Int)
(declare-const target Int)
(assert (= state-count 3))
(assert (= action-count 2))
(assert (= source 0))
(assert (= label 1))
(assert (= target 2))
(assert (and (<= 0 source) (< source state-count)))
(assert (and (<= 0 label) (< label action-count)))
(assert (and (<= 0 target) (< target state-count)))
(check-sat)
(pop)

; E4-BIS-SMT-SELF-LOOP-NOT-DEADLOCK
; State 0 has a self-loop and state 1 is deadlocked.  Transfer forbids pairing.
(push)
(declare-const relation-00 Bool)
(declare-const relation-01 Bool)
(declare-const relation-10 Bool)
(declare-const relation-11 Bool)
(assert relation-00)
(assert relation-11)
(assert (= relation-01 relation-10))
(assert (=> relation-01 false))
(assert relation-01)
(check-sat)
(pop)

; E4-BIS-SMT-VALID-STABLE-PARTITION-WITNESS
(push)
(declare-const relation-00 Bool)
(declare-const relation-01 Bool)
(declare-const relation-10 Bool)
(declare-const relation-11 Bool)
(assert relation-00)
(assert relation-11)
(assert (not relation-01))
(assert (= relation-01 relation-10))
(assert (=> relation-01 false))
(check-sat)
(pop)

; E4-BIS-SMT-CERTIFICATE-CANNOT-DROP-TRANSFERABLE-PAIR
(push)
(declare-const before-pair Bool)
(declare-const transfers Bool)
(declare-const after-pair Bool)
(assert (= after-pair (and before-pair transfers)))
(assert before-pair)
(assert transfers)
(assert (not after-pair))
(check-sat)
(pop)

; E4-BIS-SMT-REMOVAL-WITNESS-IS-SOUND
(push)
(declare-const removed Bool)
(declare-const transfers-before-removal Bool)
(assert (=> removed (not transfers-before-removal)))
(assert removed)
(assert transfers-before-removal)
(check-sat)
(pop)

; E4-BIS-SMT-SEPARATION-WITNESS-IS-COMPLETE
(push)
(declare-const initially-related Bool)
(declare-const finally-related Bool)
(declare-const removed-by-trace Bool)
(assert (= finally-related
  (and initially-related (not removed-by-trace))))
(assert initially-related)
(assert (not finally-related))
(assert (not removed-by-trace))
(check-sat)
(pop)

; E4-BIS-SMT-INJECTIVE-RELABELING-PRESERVES-CANONICAL-RELATION
(push)
(declare-const block-left Int)
(declare-const block-right Int)
(declare-const relabeled-left Int)
(declare-const relabeled-right Int)
(assert (=> (= block-left block-right)
            (= relabeled-left relabeled-right)))
(assert (=> (= relabeled-left relabeled-right)
            (= block-left block-right)))
(assert (not (= (= block-left block-right)
                (= relabeled-left relabeled-right))))
(check-sat)
(pop)

; E4-BIS-SMT-STRICT-REFINEMENT-MAKES-PROGRESS
(push)
(declare-const before-cardinality Int)
(declare-const after-cardinality Int)
(assert (>= before-cardinality 0))
(assert (>= after-cardinality 0))
(assert (< after-cardinality before-cardinality))
(assert (= after-cardinality before-cardinality))
(check-sat)
(pop)

; E4-BIS-SMT-CHARGED-WORK-IS-QUASILINEAR
(push)
(declare-const state-count Int)
(declare-const transition-count Int)
(declare-const logarithmic-charge Int)
(declare-const state-work Int)
(declare-const transition-work Int)
(assert (>= state-count 0))
(assert (>= transition-count 0))
(assert (>= logarithmic-charge 0))
(assert (<= state-work (* state-count logarithmic-charge)))
(assert (<= transition-work (* transition-count logarithmic-charge)))
(assert (> (+ state-work transition-work)
           (* (+ state-count transition-count) logarithmic-charge)))
(check-sat)
(pop)

; E4-BIS-SMT-CORE-HEAP-IS-LINEAR
(push)
(declare-const state-count Int)
(declare-const transition-count Int)
(declare-const state-cells Int)
(declare-const transition-cells Int)
(assert (>= state-count 0))
(assert (>= transition-count 0))
(assert (<= state-cells (+ (* 8 state-count) 8)))
(assert (<= transition-cells (+ (* 12 transition-count) 8)))
(assert (> (+ state-cells transition-cells)
           (+ (* 12 (+ state-count transition-count)) 16)))
(check-sat)
(pop)

; E4-BIS-SMT-NATIVE-STACK-IS-CONSTANT
(push)
(declare-const maximum-native-frames Int)
(assert (= maximum-native-frames 1))
(assert (> maximum-native-frames 1))
(check-sat)
(pop)

; E4-BIS-SMT-VALID-RESOURCE-WITNESS
(push)
(declare-const state-count Int)
(declare-const transition-count Int)
(declare-const logarithmic-charge Int)
(declare-const work Int)
(declare-const heap Int)
(declare-const maximum-native-frames Int)
(assert (= state-count 1024))
(assert (= transition-count 4096))
(assert (= logarithmic-charge 10))
(assert (= work 51200))
(assert (= heap 61456))
(assert (= maximum-native-frames 1))
(assert (<= work (* (+ state-count transition-count) logarithmic-charge)))
(assert (<= heap (+ (* 12 (+ state-count transition-count)) 16)))
(check-sat)
(pop)
